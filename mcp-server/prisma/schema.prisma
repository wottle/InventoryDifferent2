generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Device {
  id                  Int       @id @default(autoincrement())
  name                String
  additionalName      String?
  manufacturer        String?
  modelNumber         String?
  serialNumber        String?
  releaseYear         Int?
  locationId          Int?
  location            Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  info                String?   @db.Text
  isFavorite          Boolean   @default(false)

  status              Status    @default(COLLECTION)
  functionalStatus    FunctionalStatus @default(UNKNOWN)
  condition           Condition?
  rarity              Rarity?
  lastPowerOnDate     DateTime?
  hasOriginalBox      Boolean   @default(false)
  isAssetTagged       Boolean   @default(false)

  dateAcquired        DateTime?
  whereAcquired       String?
  priceAcquired       Decimal?  @db.Decimal(10, 2)
  estimatedValue      Decimal?  @db.Decimal(10, 2)

  listPrice           Decimal?  @db.Decimal(10, 2)
  soldPrice           Decimal?  @db.Decimal(10, 2)
  soldDate            DateTime?

  cpuType             String?
  cpuSpeed            String?
  ram                 String?
  graphicsChip        String?
  screenSize          String?
  displayType         String?
  displayVariant      String?
  nativeResolution    String?
  isWifiEnabled       Boolean?
  isRetroBrited       Boolean?
  isRecapped          Boolean?
  pramBatteryInstalled  Boolean?
  pramBatteryExpiryDate DateTime?
  deleted             Boolean   @default(false)

  historicalNotes     String?   @db.Text

  externalUrl         String?

  categoryId          Int
  category            Category  @relation(fields: [categoryId], references: [id])
  
  images              Image[]
  notes               Note[]
  maintenanceTasks    MaintenanceTask[]
  tags                Tag[]
  accessories         DeviceAccessory[]
  links               DeviceLink[]
  storageEntries      DeviceStorage[]
  osEntries           DeviceOS[]
  customFieldValues   CustomFieldValue[]
  relationsFrom       DeviceRelationship[] @relation("RelationFrom")
  relationsTo         DeviceRelationship[] @relation("RelationTo")
}

model DeviceStorage {
  id        Int    @id @default(autoincrement())
  deviceId  Int
  device    Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  value     String
  sortOrder Int    @default(0)
}

model DeviceOS {
  id        Int    @id @default(autoincrement())
  deviceId  Int
  device    Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  value     String
  sortOrder Int    @default(0)
}

model Location {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  devices     Device[]
}

model DeviceAccessory {
  id        Int      @id @default(autoincrement())
  deviceId  Int
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([deviceId, name])
}

model DeviceLink {
  id        Int      @id @default(autoincrement())
  deviceId  Int
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  label     String
  url       String
  createdAt DateTime @default(now())
}

model Category {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  type    CategoryType
  sortOrder Int    @default(0)
  
  devices Device[]
  templates Template[]
}

model Image {
  id          Int      @id @default(autoincrement())
  deviceId    Int
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  
  path        String
  thumbnailPath String?
  dateTaken   DateTime @default(now())
  caption     String?
  isShopImage Boolean  @default(false)
  isThumbnail Boolean  @default(false)
  isListingImage Boolean @default(false)
}

model Note {
  id          Int      @id @default(autoincrement())
  deviceId    Int
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  
  content     String   @db.Text
  date        DateTime @default(now())
}

model MaintenanceTask {
  id            Int      @id @default(autoincrement())
  deviceId      Int
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  label         String
  dateCompleted DateTime
  notes         String?  @db.Text
  cost          Decimal?  @db.Decimal(10, 2)
}

model Tag {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  devices Device[]
}

model CustomField {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isPublic  Boolean  @default(false)
  sortOrder Int      @default(0)
  values    CustomFieldValue[]
}

model CustomFieldValue {
  id            Int         @id @default(autoincrement())
  customFieldId Int
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  deviceId      Int
  device        Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  value         String
  @@unique([customFieldId, deviceId])
}

model DeviceRelationship {
  id            Int      @id @default(autoincrement())
  fromDeviceId  Int
  fromDevice    Device   @relation("RelationFrom", fields: [fromDeviceId], references: [id], onDelete: Cascade)
  toDeviceId    Int
  toDevice      Device   @relation("RelationTo", fields: [toDeviceId], references: [id], onDelete: Cascade)
  type          String
  createdAt     DateTime @default(now())
  @@unique([fromDeviceId, toDeviceId, type])
}

model Template {
  id      Int    @id @default(autoincrement())
  name    String
  additionalName  String?
  manufacturer    String?
  modelNumber     String?
  releaseYear     Int?
  estimatedValue  Decimal?  @db.Decimal(10, 2)
  cpuType         String?
  cpuSpeed        String?
  ram             String?
  graphicsChip    String?
  screenSize      String?
  displayType     String?
  displayVariant  String?
  nativeResolution String?
  storage         String?
  operatingSystem String?
  externalUrl     String?
  externalLinkLabel String?
  isWifiEnabled       Boolean?
  isPramBatteryRemoved Boolean?
  rarity          Rarity?
  historicalNotes String?   @db.Text
  isSeeded        Boolean   @default(false)

  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
}

enum Status {
  COLLECTION
  FOR_SALE
  PENDING_SALE
  SOLD
  DONATED
  IN_REPAIR
  REPAIRED
  RETURNED
  LOANED
}

enum FunctionalStatus {
  YES
  PARTIAL
  NO
  UNKNOWN
}

enum Condition {
  NEW
  LIKE_NEW
  VERY_GOOD
  GOOD
  ACCEPTABLE
  FOR_PARTS
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  VERY_RARE
  EXTREMELY_RARE
}

enum CategoryType {
  COMPUTER
  PERIPHERAL
  ACCESSORY
  OTHER
}
