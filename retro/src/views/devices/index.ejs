<%- include('../partials/header') %>

<div class="window">
  <div class="title-bar">Search &amp; Filter</div>
  <div class="window-body">
    <form method="GET" action="/devices" class="search-form">
      <label for="q">Search:</label>
      <input type="text" id="q" name="q" value="<%= q %>" size="24" class="search-input">
      &nbsp;
      <label for="category">Category:</label>
      <select id="category" name="category">
        <option value="">All Categories</option>
        <% categories.forEach(function(cat) { %>
          <option value="<%= cat.id %>" <%= categoryId === cat.id ? 'selected' : '' %>><%= cat.name %></option>
        <% }); %>
      </select>
      &nbsp;
      <label for="status">Status:</label>
      <select id="status" name="status">
        <option value="">All Statuses</option>
        <% Object.entries(STATUS_LABELS).forEach(function([val, label]) { %>
          <option value="<%= val %>" <%= status === val ? 'selected' : '' %>><%= label %></option>
        <% }); %>
      </select>
      &nbsp;
      <input type="submit" class="btn" value="Search">
      <% if (q || categoryId || status) { %>
        &nbsp;<a href="/devices">Clear</a>
      <% } %>
    </form>
  </div>
</div>

<div class="count-info">
  <% if (q || categoryId || status) { %>
    <%= total %> result<%= total !== 1 ? 's' : '' %> found
  <% } else { %>
    <%= total %> device<%= total !== 1 ? 's' : '' %> in collection
  <% } %>
  <% if (totalPages > 1) { %>
    &mdash; Page <%= page %> of <%= totalPages %>
  <% } %>
</div>

<% if (devices.length === 0) { %>
  <div class="window">
    <div class="window-body">
      <p>No devices found.<% if (q || categoryId || status) { %> <a href="/devices">Clear filters</a><% } %></p>
    </div>
  </div>
<% } else { %>
  <table class="devices-table" cellspacing="4" cellpadding="0" border="0">
    <tr>
      <% devices.forEach(function(device, i) { %>
        <% var thumb = getThumbnail(device.images); %>
        <td class="device-cell">
          <a href="/devices/<%= device.id %>" class="device-card">
            <% if (thumb) { %>
              <img src="<%= thumb.thumbnailPath %>" alt="<%= device.name %>" class="device-thumb" width="60" height="60">
            <% } else { %>
              <div class="device-thumb-placeholder"></div>
            <% } %>
            <span class="device-name"><%= device.name %></span>
            <% if (device.additionalName) { %><span class="device-meta"><%= device.additionalName %></span><% } %>
            <span class="device-meta">
              <% if (device.manufacturer) { %><%= device.manufacturer %><% } %>
              <% if (device.releaseYear) { %> &mdash; <%= device.releaseYear %><% } %>
            </span>
            <% if (device.category) { %><span class="device-meta"><%= device.category.name %></span><% } %>
            <% if (device.status) { %>
              <span class="status-badge"><%= STATUS_LABELS[device.status] || device.status %></span>
            <% } %>
          </a>
        </td>
        <% if ((i + 1) % 3 === 0 && i < devices.length - 1) { %></tr><tr><% } %>
      <% }); %>
      <% var remainder = devices.length % 3; %>
      <% if (remainder === 1) { %><td class="device-cell"></td><td class="device-cell"></td><% } %>
      <% if (remainder === 2) { %><td class="device-cell"></td><% } %>
    </tr>
  </table>
<% } %>

<% if (totalPages > 1) { %>
  <div class="pagination">
    <% if (page > 1) { %>
      <a href="/devices?q=<%= encodeURIComponent(q) %>&category=<%= categoryId || '' %>&status=<%= status %>&page=<%= page - 1 %>">&laquo; Prev</a>
    <% } %>
    <% for (var p = Math.max(1, page - 3); p <= Math.min(totalPages, page + 3); p++) { %>
      <% if (p === page) { %>
        <span class="current"><%= p %></span>
      <% } else { %>
        <a href="/devices?q=<%= encodeURIComponent(q) %>&category=<%= categoryId || '' %>&status=<%= status %>&page=<%= p %>"><%= p %></a>
      <% } %>
    <% } %>
    <% if (page < totalPages) { %>
      <a href="/devices?q=<%= encodeURIComponent(q) %>&category=<%= categoryId || '' %>&status=<%= status %>&page=<%= page + 1 %>">Next &raquo;</a>
    <% } %>
  </div>
<% } %>

<%- include('../partials/footer') %>
